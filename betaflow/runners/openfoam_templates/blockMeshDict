FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    (0       $y_min 0)
    ($length $y_min 0)
    ($length $y_max 0)
    (0       $y_max 0)
    (0       $y_min $thickness)
    ($length $y_min $thickness)
    ($length $y_max $thickness)
    (0       $y_max $thickness)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx $ny 1) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type            cyclic;
        neighbourPatch  outlet;
        faces           ((0 4 7 3));
    }
    outlet
    {
        type            cyclic;
        neighbourPatch  inlet;
        faces           ((1 2 6 5));
    }
    bottomWall
    {
        type            wall;
        faces           ((0 1 5 4));
    }
    topWall
    {
        type            wall;
        faces           ((3 7 6 2));
    }
    frontAndBack
    {
        type            empty;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

