FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Axisymmetric wedge for a circular pipe, PRESSURE-DRIVEN variant: one cell thick azimuthally, axis
// along x, radius along y, wedge opening in +/-z.
//
// AXIS HANDLING (the trap). r = 0 is a coordinate singularity in cylindrical
// geometry. The standard OpenFOAM treatment is NOT a patch: the block is
// COLLAPSED onto the axis by repeating the two axis vertices in the hex
// definition — `hex (0 1 3 2 0 1 5 4)` lists vertices 0 and 1 twice — so the
// cells adjacent to the axis are prisms, and the would-be axis faces have
// zero area and belong to no patch. Declaring a patch there (empty,
// symmetry, or wall) is the common error: it either fails to build or
// silently imposes a boundary condition on the centreline.
//
// The inlet/outlet faces are correspondingly degenerate quads (a repeated
// vertex makes them triangles), which is why they are written (0 2 4 0)
// rather than as four distinct vertices.

convertToMeters 1;

vertices
(
    (0       0        0)
    ($length 0        0)
    (0       $r_cos   $r_nsin)
    ($length $r_cos   $r_nsin)
    (0       $r_cos   $r_sin)
    ($length $r_cos   $r_sin)
);

blocks
(
    hex (0 1 3 2 0 1 5 4) ($nx $nr 1) simpleGrading (1 1 1)
);

boundary
(
    // REAL inlet/outlet patches, not a cyclic pair. On a cyclic pair the two
    // contributions cancel identically, so a checker calibrated only on
    // cyclic cases has never exercised its inlet/outlet pressure-force or
    // momentum-flux terms — which is exactly where a patient case's balance
    // lives.
    inlet
    {
        type            patch;
        faces           ((0 2 4 0));
    }
    outlet
    {
        type            patch;
        faces           ((1 1 5 3));
    }
    wall
    {
        type            wall;
        faces           ((2 3 5 4));
    }
    front
    {
        type            wedge;
        faces           ((0 1 5 4));
    }
    back
    {
        type            wedge;
        faces           ((0 2 3 1));
    }
);

